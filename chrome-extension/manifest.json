{
  "manifest_version": 3,
  "name": "Emploia — Adapte ton CV à chaque offre",
  "version": "2.0.0",
  "description": "Sur une offre LinkedIn, Indeed, Welcome to the Jungle ou France Travail : un clic, et Emploia adapte ton CV à l'offre. Remplit aussi les formulaires.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Emploia — adapter mon CV"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*",
        "*://*.indeed.com/*",
        "*://*.indeed.fr/*",
        "*://*.welcometothejungle.com/*",
        "*://*.jobteaser.com/*",
        "*://*.hellowork.com/*",
        "*://*.monster.fr/*",
        "*://*.apec.fr/*",
        "*://*.meteojob.com/*",
        "*://*.cadremploi.fr/*",
        "*://*.francetravail.fr/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab"
  ],
  "short_name": "Emploia",
  "homepage_url": "https://emploia.eu"
}
